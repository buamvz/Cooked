      m_Calls: []
  m_text: "Tags: \r\n- Calorie rich (an average of 520kcal per portion)  - Fried
    \r\nHealth Advice: \r\nSwap pork for chicken breast to reduce fat content. Using
    less sauce \r\nand rice portions will reduce calories too\n\nPortions | Calories
    | Protein | Carbs | Fats\n      1 \t  520  \t28g        57g     18g\n      2
    \t  1040  \t56g        114g    36g\n      3          1560  \t84g        171g   
    54g\n      4          2080  \t112g      228g    72g\n      5          2600  \t140g     
    285g    90g"
