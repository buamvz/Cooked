  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ingredients\r\n- 1 lb pancit bihon (rice noodles)\r\n- 1/2 lb pork (cut
    into thin slices)\r\n- 1/2 lb chicken (cooked, deboned and cut into thin slices)\r\n-
    1/8 lb snow peas\r\n- 1 cup carrots\r\n- 1/2 small cabbage (chopped)\r\n- 1 cup
    celery leaves (chopped finely)\r\n- 1 onion (chopped)\r\n- 1/2 tbsp garlic (minced)\r\n-
    2 teaspoons chicken powder\r\n- 5 tbsp soy sauce\r\n- 3 to 4 cups water\r\n-
    3 tbsp cooking oil\r\n\r\nCooking Steps\r\n1. Heat the oil in a large wok. Saute
    garlic and onion. (1 onion, \xBD tbsp garlic, 3 tbsp cooking oil)\r\n\r\n2. Add
    the pork and chicken, then let cook for 2 minutes. (1/2 lb pork, \xBD lb chicken)\r\n\r\n3.
    Add the chicken powder and water, then simmer for 15 minutes. (2 teaspoons chicken
    powder, 3 to 4 cups water)\r\n\r\n4. Add the carrots, snow peas, cabbage, and
    celery leaves, and simmer for a few minutes. (1/8 lb snow peas, 1 cup carrot,
    \xBD small cabbage, 1 cup celery leaves)\r\n\r\n5. Remove all the ingredients
    in the pot except for the liquid and set them aside.\r\n\r\n6. Add the soy sauce
    to the liquid in the pot and mix well. (5 tbsp soy sauce)\r\n\r\n7. Add the pancit
    bihon, which has been soaked in water for about 10 minutes and, mix well. Cook
    until the liquid has completely evaporated. (1 lb pancit bihon)\r\n\r\n8. Add
    the vegetables and meat that were previously cooked and simmer for a minute or
    two.\r\n\r\n9. Add the calamansi and serve hot."
