  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Culinary History: \r\nKatsudon, a dish that is credited to a restaurant
    in K\u014Dfu, Yamanashi Prefecture, is a mixture of two comfort foods: tonkatsu,
    a French dish made \r\nout of breaded deep-fried pork cutlets, introduced during
    the Meiji Era of \r\nJapan of Western inspired mass industrialisation, and Donburi
    a traditional \r\nrice dish topped up with a side dish. Japanese students and
    athletes will \r\noften eat katusdon before an important exam or competition
    as a symbol of \r\ngood luck due to \u2018katsu\u2019 being similar to the Japanese
    word for to win! "
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
