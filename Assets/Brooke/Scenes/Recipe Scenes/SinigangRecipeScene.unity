  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Ingredients\r\n- 2 pounds pork spare ribs cut into 2-inch pieces\r\n-
    8 cups water\r\n- 2 large tomatoes, quartered\r\n- 1 onion peeled and quartered\r\n-
    2 tablespoons fish sauce\r\n- 6 pieces gabi, peeled and halved depending on size\r\n-
    1 radish (labanos), peeled and sliced to \xBD inch thick half rounds\r\n- 2 finger
    chilies (siling haba)\r\n- \xBD bunch long beans (sitaw), ends trimmed and cut
    into 3-inch lengths\r\n- 1 large eggplant, ends trimmed and sliced to \xBD inch
    thick half rounds\r\n- 6 pieces okra, ends trimmed\r\n- 15 pieces large tamarind
    or 1 \xBD (1.41 ounces each) packages tamarind base powder\r\n- Salt and pepper
    to taste\r\n- 1 bunch bok choy or pechay ends, trimmed and separated into leaves\r\n\r\nCooking
    steps\r\n1. Rinse pork ribs and drain well\r\n\r\n2. In a pot over medium heat,
    combine the pork with enough water to cover. Bring to a boil, skimming off any
    scum that forms on the surface.\r\n\r\n3. Once the broth clears, add the tomatoes,
    onion, and fish sauce. Reduce the heat and simmer for about 1 to 1 \xBD hours,
    or until the meat is tender, adding more water as needed to keep at it about
    8 cups.\r\n\r\n4. Add gabi and cook for 4 to 6 minutes, or until tender.\r\n\r\n5.
    Add chilli peppers and radish. Continue to simmer for about 2 to 3 minutes.\r\n\r\n6.
    Add long beans. Continue to cook for about 2 minutes.\r\n\r\n7. Add eggplant
    and okra and cook for another 1 to 2 minutes.\r\n\r\n8. If using packaged tamarind
    base, add to the pot and stir until completely dissolved.\r\n\r\n9. Season with
    salt and pepper to taste.\r\n\r\n10. Add the bok choy and continue to cook for
    about 1 minute. Serve hot!"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
