  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PortionSizeSelector
  portionDropdown: {fileID: 1733318830}
  ingredientsText: {fileID: 957377607}
  ingredients1: '<b>MAIN</b>

    0.5 lb pork belly

    0.25 lb young tamarind

    0.25
    bunch water spinach

    2 pieces string beans

    0.5 Chinese eggplant

    0.25
    daikon radish

    2 pieces okra

    0.5 tomato

    0.5 long green pepper

    0.25
    onion

    0.5 quarts water

    Fish sauce and ground black pepper to taste'
  ingredients2: '<b>MAIN</b>

    1 lb pork belly

    0.5 lb young tamarind

    0.5
    bunch water spinach

    4 pieces string beans

    1 Chinese eggplant

    0.5
    daikon radish

    4 pieces okra

    1 tomato

    1 long green pepper

    0.5
    onion

    1 quart water

    Fish sauce and ground black pepper to taste'
  ingredients4: '<b>MAIN</b>

    2 lb pork belly

    1 lb young tamarind

    1
    bunch water spinach

    8 pieces string beans

    2 Chinese eggplants

    1
    daikon radish

    8 pieces okra

    2 tomatoes

    2 long green peppers

    1
    onion

    2 quarts water

    Fish sauce and ground black pepper to taste'
  ingredients6: '<b>MAIN</b>

    3 lb pork belly

    1.5 lb young tamarind

    1.5
    bunches water spinach

    12 pieces string beans

    3 Chinese eggplants

    1.5
    daikon radishes

    12 pieces okra

    3 tomatoes

    3 long green peppers

    1.5
    onions

    3 quarts water

    Fish sauce and ground black pepper to taste'
